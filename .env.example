# Public browser configuration. Never put secret keys in VITE_* variables.
# Leave empty for a preview build: pages are noindex and sitemap is omitted.
VITE_SITE_URL=
# Use / for a domain root, or /tony-product-design/ for a subfolder.
VITE_BASE_PATH=/
# Optional, only used when public/data/site.json contactMode = "endpoint".
# Must be an HTTPS endpoint that accepts JSON and allows your site's CORS origin.
VITE_CONTACT_ENDPOINT=
