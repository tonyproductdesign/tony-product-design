{
  "name": "tony-product-design",
  "private": true,
  "version": "2.2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "validate": "node scripts/validate-content.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check": "npm run typecheck && npm run lint && npm test",
    "build": "npm run typecheck && vite build && vite build --ssr src/entry-server.tsx --outDir .ssr --emptyOutDir && node scripts/prerender.mjs && node scripts/optimize-dist.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test:e2e": "playwright test",
    "images": "node scripts/list-product-images.mjs"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "1.2.12",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-slot": "1.2.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.47.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.3",
    "tailwind-merge": "3.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "^16.5.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.46.1",
    "vite": "8.2.2"
  }
}
